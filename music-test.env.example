# Copy to music-test.env.local. This local file is ignored by Git.
# Default source: all, api-enhanced, audius, tencent, kugou, or kuwo.
MUSIC_TEST_SOURCE=all

# Tencent/KuGou/Kuwo: local Meting starts automatically, no URL required.
# Optional local port (default 8000).
# METING_LOCAL_PORT=8000
# Only set a URL if you want to use an existing external Meting sidecar.
# METING_API_URL=http://127.0.0.1:8000/api
# METING_TOKEN=
# Optional platform cookies stay on the local server.
# METING_COOKIE_TENCENT=
# METING_COOKIE_KUGOU=
# METING_COOKIE_KUWO=

# Optional Audius server credentials; enter locally, never in the test page.
# AUDIUS_API_KEY=
# AUDIUS_BEARER_TOKEN=
# AUDIUS_API_URL=https://api.audius.co/v1

# Optional: use a separate database instead of existing NightDream/data.
# DATA_DIR=data/music-test
